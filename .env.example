# InternRadar Environment Configuration
# Copy this file to .env and customize as needed.

# Database
DATABASE_URL=sqlite:///./internradar.db

# Authentication / Security
# Replace with a persistent 64-character secret hex key in production (e.g. openssl rand -hex 32)
SECRET_KEY=your-64-character-hex-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin API Key (Protects /api/admin/* endpoints via X-Admin-Key header)
ADMIN_API_KEY=your-admin-api-key-here

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:5173","http://127.0.0.1:8000"]

# Email Service (Brevo SMTP) for OTP and notifications
# Sign up at https://www.brevo.com → Settings → SMTP & API → SMTP
# SMTP_USER = your Brevo login email
# SMTP_PASSWORD = your Brevo SMTP master password (NOT your account password)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@internradar.in
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# File Uploads (Resumes & Avatars)
UPLOAD_DIR=./uploads
MAX_RESUME_SIZE_MB=5

# Listing Maintenance
CLOSING_SOON_DAYS=7
LINK_CHECK_BATCH=50
LINK_RECHECK_HOURS=72

# Background Scheduler
ENABLE_SCHEDULER=true
IMPORT_INTERVAL_HOURS=12
STATUS_REFRESH_MINUTES=60
LINK_CHECK_INTERVAL_HOURS=6

# Recommendation Weights (Normalized automatically)
W_SKILL=0.50
W_INTEREST=0.20
W_LOCATION=0.15
W_WORK_TYPE=0.10
W_RESUME=0.05
RECOMMEND_CANDIDATE_CAP=5000

# Discovery Settings
SOURCES_FILE=sources.json
INDIA_ONLY=true
IMPORT_ON_START=false
HTTP_TIMEOUT=15.0
HTTP_RETRIES=3
HOST_CONCURRENCY=3
DISCOVERY_WORKERS=6
GREENHOUSE_DETAIL_CAP=150
LIVE_TTL_HOURS=48
DETECT_CLOSED_PAGES=true
CRAWL_DELAY_SECONDS=2.0
CRAWL_MAX_PAGES=60

# Built-in Source Adapter
SOURCE_REMOTIVE=false

# Adzuna Licensed API (Optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Semantic Matching (Optional, requires sentence-transformers)
ENABLE_SEMANTIC=false
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
W_SEMANTIC=0.15

# Rate Limiting
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_MINUTE=10
