# ==========================================
# InternRadar .gitignore
# ==========================================

# Environments & Secrets
.env
.env.local
.env.*.local
*.env
!.env.example

# Local Databases & Persistent Storage
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# User Uploads & Media
uploads/*
!uploads/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
/build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.cache

# IDE, Editors & OS Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Logs & Temporary Files
*.log
logs/
*.tmp
*.bak
